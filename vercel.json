{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/collections", "dest": "/collections.html" },
    { "src": "/deals", "dest": "/deals.html" },
    { "src": "/offers", "dest": "/deals.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/about-us", "dest": "/about.html" },
    { "src": "/products/(.*)", "dest": "/product.html" },
    { "src": "/product/(.*)", "dest": "/product.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
